# Commerce routing
# Keep legacy as the safe default. Only the Vercel Preview environment currently
# sets this to "medusa"; Production must remain "legacy" until release approval.
NEXT_PUBLIC_COMMERCE_BACKEND=legacy

# Required only when NEXT_PUBLIC_COMMERCE_BACKEND=medusa.
# NEXT_PUBLIC_* values are exposed to browsers; the publishable key is not a secret.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_medusa_publishable_key

# Local development only. Leave unset in Vercel Preview and Production until the
# private-artwork ownership flow is approved for hosted environments.
# NEXT_PUBLIC_MEDUSA_PRIVATE_ARTWORK=dev-private

# Stripe
# Use test-mode values for Preview validation. Never put a live key in a Preview.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SHIPPING_RATE_TEST=shr_...

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_token

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
